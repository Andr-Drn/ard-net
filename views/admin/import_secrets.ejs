<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.impsec.title', 'Impor Secret MikroTik') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .is-bar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
    .is-sum { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; font-size:12px; }
    .is-sum span { background:var(--bg2); border:1px solid var(--border); border-radius:8px; padding:5px 10px; }
    .is-wrap { max-height:62vh; overflow:auto; border:1px solid var(--border); border-radius:10px; }
    .is-wrap table { width:100%; border-collapse:collapse; font-size:12.5px; }
    .is-wrap th { position:sticky; top:0; background:var(--bg2); text-align:left; padding:8px 10px; z-index:1; }
    .is-wrap td { padding:7px 10px; border-top:1px solid var(--border); vertical-align:top; }
    .is-wrap tr.is-off td { opacity:.5; }
    .is-note { color:var(--muted); font-size:11.5px; }
    .is-res { margin-top:14px; padding:12px 14px; border-radius:10px; border:1px solid var(--border); background:var(--bg2); font-size:13px; line-height:1.6; display:none; }
    .is-hint { font-size:12px; color:var(--muted); line-height:1.6; margin-bottom:12px; }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'customers', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-hdd-network"></i>
      <span><%= t('admin.impsec.title', 'Impor Secret MikroTik') %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge" style="font-size:12px;opacity:0.7;"><%= company %></span>
      <a href="/admin/customers" class="btn btn-g btn-sm"><i class="bi bi-arrow-left"></i> Pelanggan</a>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <div class="page">
    <div class="card">
      <div class="card-hd"><h6 style="margin:0;"><i class="bi bi-cloud-download"></i> Buat data pelanggan dari secret PPPoE</h6></div>
      <div style="padding:16px;">
        <div class="is-hint">
          Halaman ini <b>hanya membaca</b> secret dari MikroTik. Tidak ada secret yang diubah atau dihapus di router.
          Setiap secret dibuat menjadi satu pelanggan (mode MikroTik API). Nama pelanggan diambil dari <i>comment</i> secret
          (kalau kosong, memakai username). Profil PPP dicocokkan dengan <b>nama paket</b> di billing; yang tidak cocok
          dibuat tanpa paket dan bisa diatur belakangan. Secret yang username-nya sudah ada di data pelanggan dilewati.
          Password hanya terbaca bila user API MikroTik punya policy <code>sensitive</code>.
        </div>

        <div class="is-bar">
          <select id="isRouter" class="fs" style="min-width:220px;max-width:340px;">
            <% if (!routers || routers.length === 0) { %>
              <option value="">Router dari pengaturan (settings.json)</option>
            <% } else { routers.forEach(function (r) { %>
              <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
            <% }); } %>
          </select>
          <button type="button" class="btn btn-p btn-sm" id="isLoad"><i class="bi bi-arrow-repeat"></i> Muat Secret</button>
          <input type="text" id="isSearch" class="fs" placeholder="Cari username / nama..." style="min-width:200px;max-width:280px;display:none;">
          <label style="display:none;align-items:center;gap:5px;font-size:12px;cursor:pointer;" id="isShowExistWrap"><input type="checkbox" id="isShowExist"> tampilkan yang sudah ada</label>
        </div>

        <div id="isMsg" class="is-note"></div>
        <div class="is-sum" id="isSum" style="display:none;"></div>

        <div class="is-wrap" id="isTableWrap" style="display:none;">
          <table>
            <thead><tr>
              <th style="width:34px;"><input type="checkbox" id="isAll"></th>
              <th>Username</th><th>Nama pelanggan</th><th>Profil</th><th>Paket</th><th>Status</th><th>Catatan</th>
            </tr></thead>
            <tbody id="isBody"></tbody>
          </table>
        </div>

        <div class="is-bar" style="margin-top:14px;display:none;" id="isActions">
          <button type="button" class="btn btn-p" id="isImport"><i class="bi bi-person-plus"></i> Impor terpilih (<span id="isCnt">0</span>)</button>
          <span class="is-note">Disarankan uji dulu dengan beberapa baris, lalu cek hasilnya di menu Pelanggan.</span>
        </div>
        <div class="is-res" id="isRes"></div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var rows = [], routerId = '', keepRes = false;
  var $ = function (id) { return document.getElementById(id); };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

  function selected() { return Array.prototype.slice.call(document.querySelectorAll('.is-sel:checked')).map(function (c) { return c.value; }); }
  function updCount() { $('isCnt').textContent = selected().length; }

  function render() {
    var q = $('isSearch').value.trim().toLowerCase();
    var showExist = $('isShowExist').checked;
    var html = '';
    rows.forEach(function (r) {
      if (r.exists && !showExist) return;
      if (q && (r.username + ' ' + r.name).toLowerCase().indexOf(q) === -1) return;
      var checked = (!r.exists && !r.disabled) ? ' checked' : '';
      var dis = r.exists ? ' disabled' : '';
      var st = r.status === 'suspended' ? '<span class="badge bw">Isolir/nonaktif</span>' : '<span class="badge bp">Aktif</span>';
      html += '<tr class="' + (r.exists ? 'is-off' : '') + '">' +
        '<td><input type="checkbox" class="is-sel" value="' + esc(r.username) + '"' + checked + dis + '></td>' +
        '<td>' + esc(r.username) + '</td><td>' + esc(r.name) + '</td><td>' + esc(r.profile) + '</td>' +
        '<td>' + (r.packageName ? esc(r.packageName) : '<span class="is-note">-</span>') + '</td>' +
        '<td>' + st + '</td><td class="is-note">' + esc((r.notes || []).join('; ')) + '</td></tr>';
    });
    $('isBody').innerHTML = html || '<tr><td colspan="7" class="is-note" style="padding:14px;">Tidak ada baris untuk ditampilkan.</td></tr>';
    updCount();
  }

  $('isLoad').addEventListener('click', function () {
    routerId = $('isRouter').value;
    $('isMsg').textContent = 'Membaca secret dari MikroTik... (bisa beberapa detik untuk ribuan secret)';
    if (!keepRes) $('isRes').style.display = 'none';
    keepRes = false;
    $('isLoad').disabled = true;
    fetch('/admin/api/customers/import-secrets/preview?routerId=' + encodeURIComponent(routerId), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        $('isLoad').disabled = false;
        if (!d.success) { $('isMsg').textContent = 'Gagal: ' + (d.error || 'tidak diketahui'); return; }
        rows = d.rows || [];
        var s = d.summary;
        $('isMsg').textContent = '';
        $('isSum').style.display = 'flex';
        $('isSum').innerHTML = '<span>Total secret: <b>' + s.total + '</b></span><span>Siap diimpor: <b>' + s.importable + '</b></span>' +
          '<span>Sudah ada: <b>' + s.existing + '</b></span><span>Disabled: <b>' + s.disabled + '</b></span>' +
          '<span>Profil belum cocok paket: <b>' + s.noPackage + '</b></span><span>Password tidak terbaca: <b>' + s.noPassword + '</b></span>';
        ['isTableWrap', 'isSearch'].forEach(function (id) { $(id).style.display = 'block'; });
        $('isShowExistWrap').style.display = 'inline-flex';
        $('isActions').style.display = 'flex';
        render();
      })
      .catch(function (e) { $('isLoad').disabled = false; $('isMsg').textContent = 'Gagal: ' + e.message; });
  });

  $('isSearch').addEventListener('input', render);
  $('isShowExist').addEventListener('change', render);
  $('isAll').addEventListener('change', function (e) {
    document.querySelectorAll('.is-sel:not(:disabled)').forEach(function (c) { c.checked = e.target.checked; });
    updCount();
  });
  document.addEventListener('change', function (e) { if (e.target.classList && e.target.classList.contains('is-sel')) updCount(); });

  $('isImport').addEventListener('click', function () {
    var list = selected();
    if (!list.length) return alert('Pilih minimal 1 secret.');
    if (!confirm('Buat ' + list.length + ' data pelanggan dari secret MikroTik?\n\nTidak ada perubahan di MikroTik.')) return;
    $('isImport').disabled = true;
    var box = $('isRes'); box.style.display = 'block'; box.textContent = 'Mengimpor...';
    fetch('/admin/api/customers/import-secrets', {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ routerId: routerId, usernames: list, includeDisabled: true })
    }).then(function (r) { return r.json(); }).then(function (d) {
      $('isImport').disabled = false;
      if (!d.success) { box.textContent = 'Gagal: ' + (d.error || 'tidak diketahui'); return; }
      var h = '<b>Selesai.</b> Dibuat: <b>' + d.created + '</b> pelanggan';
      if (d.skippedExisting) h += ' &middot; dilewati (sudah ada): ' + d.skippedExisting;
      if (d.failed && d.failed.length) {
        h += ' &middot; gagal: <b>' + d.failed.length + '</b><br><span class="is-note">' +
          d.failed.slice(0, 10).map(function (f) { return esc(f.username) + ' — ' + esc(f.error); }).join('<br>') +
          (d.failed.length > 10 ? '<br>...' : '') + '</span>';
      }
      h += '<br><a href="/admin/customers" class="btn btn-g btn-sm" style="margin-top:8px;">Lihat daftar pelanggan</a>';
      box.innerHTML = h;
      keepRes = true;
      $('isLoad').click(); // segarkan status "sudah ada", hasil tetap tampil
    }).catch(function (e) { $('isImport').disabled = false; box.textContent = 'Gagal: ' + e.message; });
  });
})();
</script>
</body>
</html>
