 const ISOLIR_ADDR_LIST = 'LIST_ISOLIR';
+// Penanda entri address-list yang dikelola otomatis dari pengaturan RADIUS billing.
+const ISOLIR_POOL_COMMENT = 'BILLING_ISOLIR_POOL';
+// Variabel PPP RouterOS yang namanya memakai tanda hubung wajib diberi kutip.
+const ROS_REMOTE_ADDRESS = '$"remote-address"';
+
+/**
+ * Rentang IP isolir dari Pengaturan RADIUS billing (radius_isolir_ip_pool_start/end)
+ * dalam format address-list MikroTik ("a-b"). Null jika isolir memakai mode reject
+ * atau rentang tidak valid. Dengan ini LIST_ISOLIR otomatis mengikuti pool isolir billing,
+ * tanpa perlu mengubah script secara manual.
+ */
+function getIsolirPoolAddressRange(settings = {}) {
+  const action = String(settings.radius_isolir_action || 'pool').trim() || 'pool';
+  if (action === 'reject') return null;
+  const start = String(settings.radius_isolir_ip_pool_start || '10.10.99.2').trim();
+  const end = String(settings.radius_isolir_ip_pool_end || '10.10.99.254').trim();
+  const a = _ipInt(start);
+  const b = _ipInt(end);
+  if (a === null || b === null || a > b) return null;
+  return a === b ? start : `${start}-${end}`;
+}
+
+/**
+ * Sinkronkan entri LIST_ISOLIR (comment BILLING_ISOLIR_POOL) dengan rentang pool isolir billing.
+ * Idempotent: entri lama yang rentangnya berbeda diganti, entri yang sudah sesuai dibiarkan.
+ */
+async function ensureIsolirPoolAddressList(conn, settings = {}) {
+  const range = getIsolirPoolAddressRange(settings);
+  const menu = conn.client.menu('/ip/firewall/address-list');
+  const rows = await menu.get();
+  const managed = (Array.isArray(rows) ? rows : []).filter((e) =>
+    String(e.list || '') === ISOLIR_ADDR_LIST && String(e.comment || '') === ISOLIR_POOL_COMMENT
+  );
+  let kept = false;
+  let changed = false;
+  for (const e of managed) {
+    const id = e['.id'] || e.id;
+    if (range && !kept && String(e.address || '') === range) {
+      kept = true;
+      if (['yes', 'true'].includes(String(e.disabled || '').toLowerCase()) && id) {
+        await menu.set({ disabled: 'no' }, id);
+        changed = true;
+      }
+      continue;
+    }
+    if (id) {
+      await menu.remove(id);
+      changed = true;
+    }
+  }
+  if (range && !kept) {
+    await menu.add({ list: ISOLIR_ADDR_LIST, address: range, comment: ISOLIR_POOL_COMMENT });
+    changed = true;
+  }
+  return { range, changed };
+}
 
